rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check for banned / prohibited initials
    function isBannedInitials(str) {
      return str in [
        'CUM', 'FAG', 'KKK', 'FUK', 'COK', 'DIK', 'SHT', 'CNT',
        'FUC', 'JIZ', 'NIG', 'CUK', 'CUC', 'PUS', 'DIX', 'PED'
      ];
    }

    // Check for initials blocked from global leaderboard recording
    function isBlockedFromLeaderboard(str) {
      return str == 'GOD' || isBannedInitials(str);
    }

    // Helper function to validate 3-character alphabetical initials (A-Z letters only, no numbers)
    function isValidInitials(str) {
      return str is string && str.size() == 3 && str.matches('^[A-Z]{3}$') && !isBannedInitials(str);
    }

    // Helper function to validate document ID format
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper function to validate pilot beam color choice
    function isValidColor(color) {
      return color in ['green', 'blue', 'amber', 'azure'];
    }

    // Story Mode Leaderboard entry (tracks completions and current story progression stage)
    function isValidStoryEntry(data) {
      return data.keys().hasAll(['initials', 'stageName', 'stageNum', 'completed', 'createdAt'])
        && isValidInitials(data.initials)
        && !isBlockedFromLeaderboard(data.initials)
        && data.stageName is string && data.stageName.size() <= 64
        && data.stageNum is number
        && data.completed is bool
        && (!('color' in data) || isValidColor(data.color))
        && (!('completions' in data) || (data.completions is number && data.completions >= 0))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50))
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Speedrun Mode Leaderboard entry (fastest completion time)
    function isValidSpeedrunEntry(data) {
      return data.keys().hasAll(['initials', 'timeSeconds', 'completed', 'createdAt'])
        && isValidInitials(data.initials)
        && !isBlockedFromLeaderboard(data.initials)
        && (!('color' in data) || isValidColor(data.color))
        && data.timeSeconds is number && data.timeSeconds >= 0 && data.timeSeconds <= 86400
        && data.completed is bool
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Survival Mode Leaderboard entry (survival time + totalHz)
    function isValidSurvivalEntry(data) {
      return data.keys().hasAll(['initials', 'survivalSeconds', 'totalHz', 'createdAt'])
        && isValidInitials(data.initials)
        && !isBlockedFromLeaderboard(data.initials)
        && (!('color' in data) || isValidColor(data.color))
        && data.survivalSeconds is number && data.survivalSeconds >= 0 && data.survivalSeconds <= 86400
        && data.totalHz is number && data.totalHz >= 0 && data.totalHz <= 100000000
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Arcade Mode Leaderboard entry (furthest stage reached, duration, totalHz)
    function isValidArcadeEntry(data) {
      return data.keys().hasAll(['initials', 'stageName', 'stageNum', 'duration', 'totalHz', 'createdAt'])
        && isValidInitials(data.initials)
        && !isBlockedFromLeaderboard(data.initials)
        && (!('color' in data) || isValidColor(data.color))
        && data.stageName is string && data.stageName.size() <= 64
        && data.stageNum is number
        && data.duration is number && data.duration >= 0 && data.duration <= 86400
        && data.totalHz is number && data.totalHz >= 0 && data.totalHz <= 100000000
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Registered player document
    function isValidPlayer(data, code) {
      return data.keys().hasAll(['code', 'createdAt'])
        && data.code == code
        && isValidInitials(code)
        && !isBlockedFromLeaderboard(code)
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Bootstrapped Admin check for administrative actions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'JacobCSanchez@gmail.com' && request.auth.token.email_verified == true;
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }

    // Registered player handles (unique 3-letter codes)
    match /players/{code} {
      allow read: if true;
      allow create: if isValidInitials(code) && code != 'GOD' && !isBlockedFromLeaderboard(code) && isValidPlayer(request.resource.data, code);
      allow update: if false;
      allow delete: if isAdmin() || isBannedInitials(code) || code == 'GOD';
    }

    // Story Mode Leaderboard (single consolidated document per pilot code)
    match /leaderboards_story/{id} {
      allow read: if true;
      allow create: if isValidId(id) && id != 'GOD' && isValidStoryEntry(request.resource.data);
      allow update: if isValidId(id) && id != 'GOD' && isValidStoryEntry(request.resource.data);
      allow delete: if isAdmin() || isBannedInitials(resource.data.initials) || id == 'GOD';
    }

    // Speedrun Mode Leaderboard
    match /leaderboards_speedrun/{id} {
      allow read: if true;
      allow create: if isValidId(id) && isValidSpeedrunEntry(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin() || isBannedInitials(resource.data.initials) || resource.data.initials == 'GOD';
    }

    // Survival Mode Leaderboard
    match /leaderboards_survival/{id} {
      allow read: if true;
      allow create: if isValidId(id) && isValidSurvivalEntry(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin() || isBannedInitials(resource.data.initials) || resource.data.initials == 'GOD';
    }

    // Arcade Mode Leaderboard
    match /leaderboards_arcade/{id} {
      allow read: if true;
      allow create: if isValidId(id) && isValidArcadeEntry(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin() || isBannedInitials(resource.data.initials) || resource.data.initials == 'GOD';
    }

    // First To Complete Story Mode (⚡FTC)
    match /leaderboards_meta/story_ftc {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/leaderboards_meta/story_ftc)
                    && request.resource.data.initials is string && isValidInitials(request.resource.data.initials)
                    && !isBlockedFromLeaderboard(request.resource.data.initials);
      allow update: if false;
      allow delete: if isAdmin() || isBannedInitials(resource.data.initials);
    }

    // First To Complete Arcade Mode (⚡FTC)
    match /leaderboards_meta/arcade_ftc {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/leaderboards_meta/arcade_ftc)
                    && request.resource.data.initials is string && isValidInitials(request.resource.data.initials)
                    && !isBlockedFromLeaderboard(request.resource.data.initials);
      allow update: if false;
      allow delete: if isAdmin() || isBannedInitials(resource.data.initials);
    }

    // Legacy Pioneer Plaque fallback
    match /leaderboards_meta/story_pioneer {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/leaderboards_meta/story_pioneer)
                    && request.resource.data.initials is string && isValidInitials(request.resource.data.initials)
                    && !isBlockedFromLeaderboard(request.resource.data.initials);
      allow update: if false;
      allow delete: if isAdmin() || isBannedInitials(resource.data.initials);
    }
  }
}
